# Copy to `.env` and adjust. Never commit `.env`.
# Local (no Docker) defaults work out of the box: SQLite, inline jobs, no Redis.

# --- App -------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173

# --- Security ----------------------------------------------------------------
# REQUIRED in production: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-insecure-change-me-dev-insecure-change-me
# Replace this before exposing a Docker Compose deployment to other users.
PROJECT_RUNNER_TOKEN=local-development-runner-token-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
ALLOW_REGISTRATION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Storage -----------------------------------------------------------------
# Local default: sqlite+aiosqlite:///backend/data/app.db
# DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333   # unset = embedded local Qdrant (stored in STORAGE_DIR/qdrant)

# --- Background jobs -----------------------------------------------------------
JOB_BACKEND=inline                  # inline (in-process) | celery (needs REDIS_URL)

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_SIZE_MB=200                 # a folder of papers as one .zip (keep the nginx limit for it >= this)

# --- AI models (used from Phase 2 onward) ----------------------------------------
LLM_PROVIDER=ollama                 # ollama | openai (any OpenAI-compatible API)
LLM_MODEL=qwen2.5:3b                # empty = provider default (ollama: qwen2.5:3b)
OLLAMA_BASE_URL=http://localhost:11434   # then: ollama pull qwen2.5:3b
CODE_LLM_MODEL=                     # optional: a stronger local Ollama model used only for coding requests
# OPENAI_API_KEY=                   # LLM_PROVIDER=openai; LLM_API_BASE for vLLM, LM Studio, ...
# LLM_API_BASE=https://api.openai.com/v1
LLM_MAX_TOKENS=700
CODE_LLM_CONTEXT_WINDOW=8192       # Ollama context size for coding requests (must fit the model's memory budget)
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=300                     # seconds; small CPU models can be slow on long prompts
EMBEDDING_PROVIDER=sentence_transformers   # sentence_transformers | openai | hashing (tests only)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5     # BGE / E5 query+passage prefixes are applied automatically
# EMBEDDING_DIMENSION=0                     # 0 = model default; needed for openai/hashing
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_API_KEY=                        # for EMBEDDING_PROVIDER=openai (any OpenAI-compatible API)
# EMBEDDING_API_BASE=https://api.openai.com/v1
MODEL_DEVICE=auto                   # auto (CUDA → MPS → CPU) | cpu | cuda | mps
MODEL_DTYPE=auto                    # auto (float16 on CUDA, else float32) | float32 | float16
MAX_LOADED_MODELS=4                 # least recently used model is unloaded beyond this
MODEL_IDLE_UNLOAD_SECONDS=900
RERANKER_PROVIDER=cross_encoder     # cross_encoder (local) | api (Jina/Cohere-style /rerank) | none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # fast on CPU; BAAI/bge-reranker-base on a GPU
# RERANKER_API_KEY=                 # for RERANKER_PROVIDER=api
# RERANKER_API_BASE=https://api.jina.ai/v1
VERIFIER_PROVIDER=nli               # nli (local cross-encoder) | lexical (word overlap, no model)
VERIFIER_MODEL=cross-encoder/nli-deberta-v3-xsmall
OCR_ENABLED=true
LOCAL_ONLY=false                    # true = refuse any remote AI provider
HF_HUB_OFFLINE=false                # true = use cached Hugging Face models without Hub checks
# Research watches: autonomous arXiv monitoring (search, score, digest, optional auto-import).
AGENT_SCHEDULER_ENABLED=true
AGENT_SCHEDULER_POLL_SECONDS=300
AGENT_WATCH_MIN_INTERVAL_HOURS=6
AGENT_WATCH_DEFAULT_INTERVAL_HOURS=24
AGENT_WATCH_LOOKBACK_DAYS=14
AGENT_WATCH_MAX_RESULTS_PER_RUN=10
AGENT_WATCH_DEFAULT_RELEVANCE_THRESHOLD=0.35
AGENT_WATCH_MAX_ACTIVE_PER_USER=10
AGENT_WATCH_SYNTHESIS_MIN_PAPERS=3
AGENT_WATCH_SYNTHESIS_MAX_PAPERS=8
# APP_BASE_URL=                       # e.g. https://your-domain; used in Slack/Discord links
# Each user's own model (Settings -> AI): their API key, or a model on a private network.
ALLOW_USER_API_KEYS=true            # users may bring a key (OpenAI, Gemini, Groq, ...)
# ALLOW_LOCAL_MODELS=               # unset = allowed except in production; true for a self-hosted copy
# MODEL_KEY_SECRET=                 # encrypts saved keys; unset = derived from JWT_SECRET

# --- A public site with a shared free model (docs/DEPLOYMENT.md, "A free model for everyone") ---
# Every user reaches one free hosted model through this server's one key. Example: NVIDIA
# Nemotron 3 Ultra, free on OpenRouter (20 requests a minute; 50 a day, or 1000 a day once the
# account has bought $10 of credits, for the whole site). Then check it: python -m app.cli check-model
# LLM_PROVIDER=openai
# LLM_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...       # the site's key; never shown to users
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# FREE_TIER=true                    # users opt in (their text goes to the host); paced; daily allowance; no auto-summaries
# FREE_TIER_LABEL=Nemotron 3 Ultra (free)
# FREE_TIER_HOST=NVIDIA, through OpenRouter   # who receives the text, as users are told
# FREE_TIER_REQUESTS_PER_MINUTE=15  # all users together: one call every 60/N seconds (0 = no pacing)
# FREE_TIER_REQUESTS_PER_DAY=950    # all users together; 0 = the key has no daily limit
# FREE_TIER_DAILY_REQUESTS_PER_USER=50   # one answer = 1 request; a summary or review = several
# FREE_TIER_MAX_WAIT_SECONDS=120    # how long a call may queue before "busy, try again"
# Nemotron reasons before answering; left on, the thinking used up the answer budget and landed in
# summaries (seen with the real model). Off, answers are clean and start in 1-3 s:
# LLM_EXTRA_BODY='{"reasoning": {"enabled": false}}'   # extra request fields for the server's model
# The same model from NVIDIA's own API (key from build.nvidia.com; no daily limit published;
# read its terms before a public site): LLM_API_BASE=https://integrate.api.nvidia.com/v1,
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b, FREE_TIER_REQUESTS_PER_DAY=0, and
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# DOWNLOAD_URL=                     # where people get the code to run their own copy (Settings and Help link to it)

# --- Retrieval ---------------------------------------------------------------
CHUNKING_STRATEGY=section_aware     # section_aware | semantic | sentence | recursive | fixed
CHUNK_SIZE=384                      # in the embedding model's tokens (BGE truncates at 512)
CHUNK_OVERLAP=64
CONTEXTUAL_CHUNK_HEADERS=true       # embed "Paper › Section" with each passage
# After changing the embedding model or chunking: python -m app.cli reindex --all
TOP_K=50                            # candidates per retriever before fusion

# --- Research chat (RAG) -------------------------------------------------------
CONTEXT_TOKEN_BUDGET=2500           # evidence tokens sent to the model
CONTEXT_MAX_PASSAGES=8
CONTEXT_MIN_RELEVANCE=0.02          # reranker probability floor; below it a passage isn't used
CHAT_HISTORY_TURNS=3
RERANK_CANDIDATES=30                # fused passages rescored by the reranker
RERANK_TOP_K=10                     # passages kept for answer context (Phase 6)
RRF_K=60                            # reciprocal rank fusion constant
SPARSE_RETRIEVER=bm25               # bm25 (own, in-memory) | postgres (PostgreSQL full-text search)
BM25_K1=1.2                         # term-frequency saturation
BM25_B=0.75                         # document-length normalization
WARM_MODELS_ON_STARTUP=true         # load the embedding model at startup, not on the first search
CACHE_ENABLED=true

# --- Paper summaries -----------------------------------------------------------
SUMMARY_AUTO=true                   # summarize each paper after indexing (only if the model is ready)
SUMMARY_CONTEXT_TOKENS=1400         # passage tokens per section group (one model call per group)
SUMMARY_MAX_PASSAGES=6
SUMMARY_MAX_TOKENS=450              # output cap per section group

# --- Usage, caches and limits (Phase 14-15) ------------------------------------------
# LLM_PRICES={"gpt-4.1-mini": [0.4, 1.6]}   # USD per million input / output tokens, per model
LLM_PRICE_INPUT_PER_MILLION=0       # default for other models (local models cost nothing)
LLM_PRICE_OUTPUT_PER_MILLION=0
ANSWER_CACHE_ENABLED=true           # reuse a checked answer to a near-identical first question
ANSWER_CACHE_MIN_SIMILARITY=0.95
ANSWER_CACHE_DAYS=30
CHAT_MAX_CONCURRENT_PER_USER=2      # answers one user may have streaming at once
RESUME_JOBS_ON_STARTUP=true         # inline jobs interrupted by a restart resume (max 3 tries)
# METRICS_TOKEN=                    # when set, GET /metrics needs "Authorization: Bearer <token>"
# GRAFANA_PASSWORD=                 # docker compose --profile observability
